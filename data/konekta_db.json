  "posts": [
    {
      "id": "post_1792680766939_qkdax",
      "authorId": "usr_elena",
      "content": "Testing real-time publishing on KONEKTA! 🚀",
      "mediaUrls": [],
      "groupId": null,
      "repostOfPostId": null,
      "visibility": "public",
      "createdAt": "2026-10-22T14:52:46.939Z",
      "updatedAt": "2026-10-22T14:52:46.939Z"
    },
    {
      "id": "post_1",
      "authorId": "usr_elena",
      "content": "Golden hour over Manila Bay today. There is an unspoken poetry in the rhythm of our daily commute when the sky turns lavender and gold. 🌇\n\nHope everyone is finding quiet moments of inspiration amid the bustle!",
      "mediaUrls": [
        "https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&w=1200&q=80"
      ],
      "groupId": null,
      "repostOfPostId": null,
      "visibility": "public",
      "createdAt": "2026-10-22T08:39:35.471Z",
      "updatedAt": "2026-10-22T08:39:35.471Z"
    },
    {
      "id": "post_2",
      "authorId": "usr_marcus",
      "content": "Just shipped the first component library draft for our international platform! Design systems truly flourish when built with multi-lingual scripts and variable font optical sizes in mind from day one. What are your core guidelines when designing across boundaries?",
      "mediaUrls": [],
      "groupId": "grp_creatives",
      "repostOfPostId": null,
      "visibility": "group",
      "createdAt": "2026-10-22T00:39:35.471Z",
      "updatedAt": "2026-10-22T00:39:35.471Z"
    },
    {
      "id": "post_3",
      "authorId": "usr_sofia",
      "content": "Morning walk through Gothic Quarter alleys in Barcelona. Warm espresso, freshly baked pan con tomate, and scribbling ideas for the new cultural dispatch series.",
      "mediaUrls": [
        "https://images.unsplash.com/photo-1539037116277-4db20889f2d4?auto=format&fit=crop&w=1200&q=80"
      ],
      "groupId": null,
      "repostOfPostId": null,
      "visibility": "public",
      "createdAt": "2026-10-21T16:39:35.471Z",
      "updatedAt": "2026-10-21T16:39:35.471Z"
    },
    {
      "id": "post_4",
      "authorId": "usr_kenji",
      "content": "Experimenting with local-first peer sync and lightweight client-side state. The modern web platform has progressed tremendously—building fast, resilient applications without heavy lock-in is more achievable than ever. 💻⚡",
      "mediaUrls": [],
      "groupId": "grp_indiedev",
      "repostOfPostId": null,
      "visibility": "group",
      "createdAt": "2026-10-21T08:39:35.471Z",
      "updatedAt": "2026-10-21T08:39:35.471Z"
    },
    {
      "id": "post_5",
      "authorId": "usr_amara",
      "content": "Excited to announce our upcoming youth tech mentorship session in Lagos! We have 45 brilliant young women joining us to learn their first lines of code and build community problem-solving apps. “Bringing people closer” starts right here. 🌱✨",
      "mediaUrls": [
        "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=80"
      ],
      "groupId": null,
      "repostOfPostId": null,
      "visibility": "public",
      "createdAt": "2026-10-20T22:39:35.471Z",
      "updatedAt": "2026-10-20T22:39:35.471Z"
    }
  ],
