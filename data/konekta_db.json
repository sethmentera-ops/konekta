  "messages": [
    {
      "id": "msg_1",
      "conversationId": "conv_1",
      "senderId": "usr_marcus",
      "content": "Hi Elena! Did you see the new palette options for the KONEKTA project?",
      "createdAt": "2026-10-22T10:39:35.471Z"
    },
    {
      "id": "msg_2",
      "conversationId": "conv_1",
      "senderId": "usr_elena",
      "content": "Yes! The midnight navy paired with turquoise and royal blue feels energetic and very crisp.",
      "createdAt": "2026-10-22T11:39:35.471Z"
    },
    {
      "id": "msg_3",
      "conversationId": "conv_1",
      "senderId": "usr_marcus",
      "content": "Awesome. I am finishing the responsive view tests now so everything feels effortless on both mobile and desktop.",
      "createdAt": "2026-10-22T12:39:35.471Z"
    },
    {
      "id": "msg_4",
      "conversationId": "conv_2",
      "senderId": "usr_sofia",
      "content": "Elena! Whenever you are in Europe next, we must organize a photography walk together.",
      "createdAt": "2026-10-22T05:39:35.471Z"
    },
    {
      "id": "msg_5",
      "conversationId": "conv_2",
      "senderId": "usr_elena",
      "content": "Count me in! I will bring my 35mm lens and we will find the best rooftop vistas.",
      "createdAt": "2026-10-22T06:39:35.471Z"
    },
